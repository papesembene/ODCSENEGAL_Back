# EXAMPLE ONLY. Store real values outside Git, mode 600.
APP_VERSION=release-test
ODC_HTTP_PORT=8085
FLASK_ENV=production
FRONTEND_URL=https://test.example.org
NEXT_PUBLIC_API_URL=https://test.example.org
CORS_ALLOWED_ORIGINS=https://test.example.org
# Dedicated database. Do not copy the previous production database blindly.
MONGO_URI=mongodb://user:REPLACE_PASSWORD@mongo.internal:27017/odcdb_prod_2026?authSource=admin
MONGO_DBNAME=odcdb_prod_2026
MONGO_MAX_POOL_SIZE=30
MONGO_MIN_POOL_SIZE=0
SECRET_KEY=
JWT_SECRET_KEY=
METRICS_TOKEN=
# Choose brevo (HTTP API), brevo_smtp, sendgrid or smtp explicitly.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Orange Digital Center
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
CONTACT_RECIPIENT_EMAIL=
EMAIL_SEND_INTERVAL_SECONDS=1
EMAIL_MAX_ATTEMPTS=5
EMAIL_TIMEOUT_SECONDS=15
WAITRESS_THREADS=8
RUN_PREPROD_SEED=false
